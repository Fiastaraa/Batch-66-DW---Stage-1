<div class="container py-5">
    <div class="row mb-4">
        <div class="col-lg-8">
            <h1 class="display-5 fw-bold">My Projects</h1>
            <p class="lead text-muted">Explore my latest projects and work</p>
        </div>
        <div class="col-lg-4 text-lg-end">
            <a href="/add-project" class="btn btn-primary btn-lg">
                <i class="fas fa-plus"></i> Add New Project
            </a>
        </div>
    </div>

    {{#if projects}}
        <div class="row">
            {{#each projects}}
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100 shadow-sm project-card">
                        {{#if image}}
                            <img src="{{image}}" class="card-img-top" alt="{{title}}" style="height: 200px; object-fit: cover;">
                        {{else}}
                            <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center" style="height: 200px;">
                                <i class="fas fa-image text-white" style="font-size: 3rem;"></i>
                            </div>
                        {{/if}}
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">{{title}}</h5>
                            <p class="card-text text-muted" style="flex-grow: 1;">{{description}}</p>
                            {{#if technologies}}
                                <div class="mb-3">
                                    {{#each technologies}}
                                        <span class="badge bg-primary me-1 mb-1">{{this}}</span>
                                    {{/each}}
                                </div>
                            {{/if}}
                            <div class="btn-group w-100 mt-auto" role="group">
                                <a href="/project/{{id}}" class="btn btn-primary btn-sm">
                                    <i class="fas fa-eye"></i> View
                                </a>
                                <a href="/edit-project/{{id}}" class="btn btn-warning btn-sm">
                                    <i class="fas fa-edit"></i> Edit
                                </a>
                                <form method="POST" action="/delete-project/{{id}}" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete this project?');">
                                    <button type="submit" class="btn btn-danger btn-sm">
                                        <i class="fas fa-trash"></i> Delete
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            {{/each}}
        </div>
    {{else}}
        <div class="alert alert-info text-center py-5">
            <i class="fas fa-inbox" style="font-size: 3rem;"></i>
            <h4 class="mt-3">No projects available yet</h4>
            <p class="text-muted mb-3">Start by adding your first project!</p>
            <a href="/add-project" class="btn btn-primary">
                <i class="fas fa-plus"></i> Add Your First Project
            </a>
        </div>
    {{/if}}
</div>
