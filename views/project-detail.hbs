<section class="section-panel">
  <div class="mb-4">
    <p class="eyebrow mb-2">{{project.category}}</p>
    <h1 class="mb-1">{{project.title}}</h1>
    <div class="d-flex flex-wrap gap-3 mb-3">
      <span class="badge {{badgeClass project.status}} rounded-pill">{{project.status}}</span>
      {{#if project.isFeatured}}
        <span class="badge text-bg-warning rounded-pill">Featured</span>
      {{/if}}
    </div>
  </div>

  <div class="row g-4">
    <div class="col-lg-8">
      <div class="card border-0 shadow-sm">
        <div class="card-body">
          <h2 class="h4 mb-3">Project Overview</h2>
          <p class="mb-4">{{project.description}}</p>

          {{#if project.challenge}}
            <h3 class="h5 mb-2">Challenge</h3>
            <p class="mb-4">{{project.challenge}}</p>
          {{/if}}

          {{#if project.solution}}
            <h3 class="h5 mb-2">Solution</h3>
            <p class="mb-4">{{project.solution}}</p>
          {{/if}}

          <div class="d-flex flex-wrap gap-2 mb-4">
            {{#each project.technologies}}
              <span class="chip">{{this}}</span>
            {{/each}}
          </div>

          <div class="d-flex gap-2">
            <a href="/projects/{{project.id}}/edit" class="btn btn-outline-primary">Edit Project</a>
            <form action="/projects/{{project.id}}/delete" method="POST" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this project?')">
              <button type="submit" class="btn btn-outline-danger">Delete Project</button>
            </form>
          </div>
        </div>
      </div>
    </div>

    <div class="col-lg-4">
      <div class="card border-0 shadow-sm">
        <div class="card-body">
          <h3 class="h5 mb-3">Project Details</h3>
          <dl class="row">
            <dt class="col-sm-4">Category</dt>
            <dd class="col-sm-8">{{project.category}}</dd>

            <dt class="col-sm-4">Status</dt>
            <dd class="col-sm-8">{{project.status}}</dd>

            {{#if project.year}}
              <dt class="col-sm-4">Year</dt>
              <dd class="col-sm-8">{{project.year}}</dd>
            {{/if}}

            <dt class="col-sm-4">Created</dt>
            <dd class="col-sm-8">{{formatDate project.createdAt}}</dd>

            <dt class="col-sm-4">Updated</dt>
            <dd class="col-sm-8">{{formatDate project.updatedAt}}</dd>
          </dl>
        </div>
      </div>
    </div>
  </div>

  <div class="mt-4">
    <a href="/projects" class="btn btn-outline-dark">← Back to Projects</a>
  </div>
</section>