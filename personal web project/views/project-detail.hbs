<div class="container py-5">
    <div class="row mb-4">
        <div class="col-lg-8">
            <a href="/projects" class="btn btn-outline-secondary mb-3">
                <i class="fas fa-arrow-left"></i> Back to Projects
            </a>
        </div>
        <div class="col-lg-4 text-lg-end">
            <a href="/edit-project/{{project.id}}" class="btn btn-warning me-2">
                <i class="fas fa-edit"></i> Edit
            </a>
            <form method="POST" action="/delete-project/{{project.id}}" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete this project?');">
                <button type="submit" class="btn btn-danger">
                    <i class="fas fa-trash"></i> Delete
                </button>
            </form>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8 mb-4">
            {{#if project.image}}
                <img src="{{project.image}}" alt="{{project.title}}" class="img-fluid rounded mb-4" style="max-height: 500px; width: 100%; object-fit: cover;">
            {{else}}
                <div class="bg-secondary rounded mb-4 d-flex align-items-center justify-content-center" style="height: 400px; width: 100%;">
                    <i class="fas fa-image text-white" style="font-size: 5rem;"></i>
                </div>
            {{/if}}
            
            <h1 class="display-4 fw-bold mb-3">{{project.title}}</h1>
            
            <div class="mb-4">
                <h5>Description</h5>
                <p class="lead">{{project.description}}</p>
            </div>
            
            {{#if project.technologies}}
                <div class="mb-4">
                    <h5>Technologies Used</h5>
                    <div class="d-flex flex-wrap gap-2">
                        {{#each project.technologies}}
                            <span class="badge bg-primary" style="font-size: 1rem; padding: 0.5rem 1rem;">{{this}}</span>
                        {{/each}}
                    </div>
                </div>
            {{/if}}
            
            {{#if project.link}}
                <div class="mb-4">
                    <a href="{{project.link}}" target="_blank" class="btn btn-primary btn-lg">
                        <i class="fas fa-external-link-alt"></i> View Project
                    </a>
                </div>
            {{/if}}
        </div>
        
        <div class="col-lg-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Project Information</h5>
                    <hr>
                    <p>
                        <strong>Created:</strong><br>
                        <small>{{project.createdAt}}</small>
                    </p>
                    <p>
                        <strong>Status:</strong><br>
                        <span class="badge bg-success">Completed</span>
                    </p>
                    {{#if project.technologies}}
                        <p>
                            <strong>Tech Stack:</strong><br>
                            {{#each project.technologies}}
                                <small class="badge bg-secondary me-1">{{this}}</small>
                            {{/each}}
                        </p>
                    {{/if}}
                </div>
            </div>
        </div>
    </div>
</div>
