<div class="container py-5">
    <div class="row">
        <div class="col-lg-8 offset-lg-2">
            <h1 class="display-5 fw-bold mb-4">Let's Connect</h1>
            <p class="lead text-muted mb-5">Feel free to reach out to me with any questions or opportunities!</p>
            
            <div class="row mb-5">
                <div class="col-md-6 mb-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-body text-center">
                            <i class="fas fa-map-marker-alt text-primary" style="font-size: 2.5rem;"></i>
                            <h5 class="card-title mt-3">Location</h5>
                            <p class="card-text">South Tangerang City, Banten, Indonesia</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 mb-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-body text-center">
                            <i class="fas fa-envelope text-primary" style="font-size: 2.5rem;"></i>
                            <h5 class="card-title mt-3">Email</h5>
                            <p class="card-text">
                                <a href="mailto:fiasseikha@gmail.com" class="text-decoration-none">fiasseikha@gmail.com</a>
                            </p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 mb-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-body text-center">
                            <i class="fas fa-phone text-primary" style="font-size: 2.5rem;"></i>
                            <h5 class="card-title mt-3">Phone</h5>
                            <p class="card-text">+62 895-3277-4755</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 mb-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-body text-center">
                            <i class="fas fa-linkedin text-primary" style="font-size: 2.5rem;"></i>
                            <h5 class="card-title mt-3">LinkedIn</h5>
                            <p class="card-text">
                                <a href="https://www.linkedin.com/in/fiastara-arthanev/" target="_blank" class="text-decoration-none">Visit LinkedIn</a>
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-body">
                    <h3 class="card-title mb-4">Send Me a Message</h3>
                    <form id="contactForm">
                        <div class="mb-3">
                            <label for="name" class="form-label">Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="name" name="name" placeholder="Your name" required>
                        </div>

                        <div class="mb-3">
                            <label for="email" class="form-label">Email <span class="text-danger">*</span></label>
                            <input type="email" class="form-control" id="email" name="email" placeholder="your@email.com" required>
                        </div>

                        <div class="mb-3">
                            <label for="subject" class="form-label">Subject <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="subject" name="subject" placeholder="Message subject" required>
                        </div>

                        <div class="mb-3">
                            <label for="message" class="form-label">Message <span class="text-danger">*</span></label>
                            <textarea class="form-control" id="message" name="message" rows="5" placeholder="Your message..." required></textarea>
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg w-100">
                            <i class="fas fa-paper-plane"></i> Send Message
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
document.getElementById('contactForm').addEventListener('submit', function(e) {
    e.preventDefault();
    alert('Thank you for your message! I will get back to you soon.');
    this.reset();
});
</script>
