<div class="col-md-6 col-lg-3 mb-4">
    <div class="card h-100 shadow-sm project-card">
        {{#if image}}
            <img src="{{image}}" class="card-img-top" alt="{{title}}" style="height: 200px; object-fit: cover;">
        {{else}}
            <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center" style="height: 200px;">
                <i class="fas fa-image text-white" style="font-size: 3rem;"></i>
            </div>
        {{/if}}
        <div class="card-body d-flex flex-column">
            <h5 class="card-title">{{title}}</h5>
            <p class="card-text text-muted" style="flex-grow: 1;">{{description}}</p>
            {{#if technologies}}
                <div class="mb-3">
                    {{#each technologies}}
                        <span class="badge bg-primary me-1">{{this}}</span>
                    {{/each}}
                </div>
            {{/if}}
            <a href="/project/{{id}}" class="btn btn-primary btn-sm">View Project</a>
        </div>
    </div>
