<!DOCTYPE html>
<html>
<head>
  <title>My Projects</title>
</head>
<body>

<h1>My Projects</h1>

{{#if projects.length}}
  {{#each projects}}
    <div style="border:1px solid black; padding:10px; margin:10px;">
      
      <h2>{{this.title}}</h2>
      
      <p>{{this.description}}</p>
      
      <p><strong>Author:</strong> {{this.author}}</p>

      <p><strong>Technologies:</strong></p>
      <ul>
        {{#each this.technologies}}
          <li>{{this}}</li>
        {{/each}}
      </ul>

      <a href="/project/{{this.id}}">View Detail</a>

    </div>
  {{/each}}
{{else}}
  <p>No projects found</p>
{{/if}}

</body>
</html>