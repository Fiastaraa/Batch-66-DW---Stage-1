<!-- Featured Projects Section -->
<section class="py-5">
    <div class="container">
        <h2 class="h2 fw-bold mb-4">Featured Projects</h2>
        {{#if projects}}
            <div class="row">
                {{#each projects}}
                    {{>project-card}}
                {{/each}}
            </div>
        {{else}}
