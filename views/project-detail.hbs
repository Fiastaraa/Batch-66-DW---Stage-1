<section class="section-panel">
  <div class="d-flex flex-column flex-lg-row justify-content-between gap-3 mb-4">
    <div>
      <p class="eyebrow mb-2">{{project.category}}</p>
      <h1 class="mb-2">{{project.title}}</h1>
      <div class="d-flex flex-wrap gap-2">
        <span class="badge {{badgeClass project.status}} rounded-pill">{{project.status}}</span>
        {{#if project.isFeatured}}
          <span class="badge text-bg-dark rounded-pill">Featured</span>
        {{/if}}
        <span class="badge text-bg-light rounded-pill border">{{project.year}}</span>
      </div>
    </div>

    <div class="d-flex gap-2 align-self-lg-start">
      <a href="/projects/{{project.slug}}/edit" class="btn btn-outline-dark">Edit</a>
      <form action="/projects/{{project.slug}}/delete" method="POST">
        <button
          type="submit"
          class="btn btn-outline-danger"
          onclick="return confirm('Delete this project?');"
        >
          Delete
        </button>
      </form>
    </div>
  </div>

  <div class="row g-4">
    <div class="col-lg-8">
      <div class="content-card mb-4">
        <h2 class="h4">Description</h2>
        <p class="mb-0">{{project.description}}</p>
      </div>

      <div class="content-card mb-4">
        <h2 class="h4">Challenge</h2>
        <p class="mb-0">{{project.challenge}}</p>
      </div>

      <div class="content-card">
        <h2 class="h4">Solution</h2>
        <p class="mb-0">{{project.solution}}</p>
      </div>
    </div>

    <div class="col-lg-4">
      <div class="content-card mb-4">
        <h2 class="h5">Technologies</h2>
        <div class="d-flex flex-wrap gap-2">
          {{#each project.technologies}}
            <span class="chip">{{this}}</span>
          {{/each}}
        </div>
      </div>

      <div class="content-card">
        <h2 class="h5">Dynamic Route</h2>
        <p class="text-muted mb-2">This page uses the route below to load project details.</p>
        <code>/projects/{{project.slug}}</code>
      </div>
    </div>
  </div>
</section>
