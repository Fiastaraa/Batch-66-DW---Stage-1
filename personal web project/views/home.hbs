<div class="container">
    <!-- Hero -->
    <section id="hero">
        <div class="row align-items-center flex-column-reverse flex-md-row">
            <div class="col-md-7 mt-5 mt-md-0 hero-text">
                <h1 class="display-4 fw-bold mb-3" style="color: #95292D;">Fiastara Seikha Arthanev</h1>
                <h4 class="mb-3">I'm a Fullstack Engineer</h4>
                <p class="lead text-dark mb-4" style="line-height: 1.8; text-align: justify;">
                    With 5 years of experience in computer science and expertise in information systems, I have a strong background in office management, data analytics, UI/UX design, and mobile application development. I have a strong enthusiasm for data science and Android development.
                </p>
                <div class="mb-4">
                    <p class="mb-1">
                        <i class="fas fa-map-marker-alt me-2" style="color: #95292D;"></i>
                        South Tangerang City, Banten, Indonesia
                    </p>
                </div>
                <div class="d-grid d-md-flex gap-3 justify-content-center justify-content-md-start">
                    <a href="/contact" class="btn btn-main">Get In Touch</a>
                    <a href="https://dw-day-10-fiastara.netlify.app/src/CV-fiastara.pdf" download="CV_Fiastara.pdf" class="btn btn-outline-custom">
                        <i class="fas fa-download me-2"></i>Download CV
                    </a>
                </div>
            </div>
            <div class="col-md-5 text-center">
                <img src="https://dw-day-10-fiastara.netlify.app/src/fiastara.jpg" alt="Fiastara" class="img-fluid hero-img" />
            </div>
        </div>
    </section>

    <!-- Education -->
    <section id="education">
        <h2 class="section-title">Education & Certifications</h2>
        <div class="custom-grid">
            <article class="custom-card">
                <h3>Bachelor's Degree</h3>
                <p>Information Systems from Mercu Buana University (Sep 2019 - Feb 2024)</p>
            </article>
            <article class="custom-card">
                <h3>Certifications</h3>
                <p>BNSP Certified, EC-Council Certified Secure Computer User, Cisco Certification Network Associate (CCNA), IBM certifications in AI & Cybersecurity.</p>
            </article>
        </div>
    </section>

    <!-- Skills -->
    <section id="skills">
        <h2 class="section-title">Skills</h2>
        <div class="text-center">
            <span class="skill-badge">Communication</span>
            <span class="skill-badge">Analytical Thinking</span>
            <span class="skill-badge">Problem-Solving</span>
            <span class="skill-badge">Leadership</span>
            <span class="skill-badge">HTML5</span>
            <span class="skill-badge">CSS</span>
            <span class="skill-badge">JavaScript</span>
            <span class="skill-badge">Bootstrap</span>
            <span class="skill-badge">Android Studio</span>
            <span class="skill-badge">UI/UX Figma</span>
            <span class="skill-badge">RPA</span>
            <span class="skill-badge">Data Analyst</span>
            <span class="skill-badge">Python for Data Science</span>
        </div>
    </section>

    <!-- Experience -->
    <section id="experience">
        <h2 class="section-title">Experience / Work Process</h2>
        <div class="custom-grid">
            <article class="custom-card">
                <h3>IBM Academy Intern</h3>
                <p><strong>Aug 2023 - Jan 2024</strong></p>
                <p>Participated in instructor-led classes and hands-on workshops to learn about AI, hybrid cloud, and cybersecurity.</p>
            </article>
            <article class="custom-card">
                <h3>Front End Developer Intern</h3>
                <p><strong>Mar 2023 - Aug 2023</strong></p>
                <p>Collaborating with the IT team in the development and maintenance of the Humanity First Indonesia digital platform. Designing and implementing responsive UI/UX interface designs using WordPress.</p>
            </article>
            <article class="custom-card">
                <h3>Mobile App and Cloud Dev Intern</h3>
                <p><strong>Mar 2022 - Aug 2022</strong></p>
                <p>Leading the design and development of mobile applications and solutions for assigned topics.</p>
            </article>
        </div>
    </section>

    <!-- Portfolio -->
    <section id="portfolio">
        <h2 class="section-title">Portfolio</h2>
        <div class="custom-grid">
            <article class="custom-card">
                <h3>JavaScript Core Concepts</h3>
                <p>Interactive learning platform demonstrating Array Methods (map, filter, reduce), Callback Functions, and Functional Programming with live demonstrations.</p>
                <a href="/js-concepts" class="btn btn-main">View Concepts</a>
            </article>
            <article class="custom-card">
                <h3>Android App Development</h3>
                <p>Developed mobile applications using Android Studio, focusing on user experience and performance.</p>
                <a href="/android-project" class="btn btn-main">View Project</a>
            </article>
            <article class="custom-card">
                <h3>UI/UX Design Project</h3>
                <p>Created intuitive user interfaces using Figma, emphasizing usability and aesthetics.</p>
                <a href="/uiux-project" class="btn btn-main">View Project</a>
            </article>
            <article class="custom-card">
                <h3>Web Development</h3>
                <p>Built responsive websites using HTML, CSS, and JavaScript for various clients.</p>
                <a href="/web-development" class="btn btn-main">View Project</a>
            </article>
        </div>
    </section>

    <!-- Featured Projects -->
    <section id="projects">
        <h2 class="section-title">Featured Projects</h2>
        <p class="text-center">Rendered from JavaScript with search, filter, and storage.</p>
        {{#if projects}}
        <div class="custom-grid">
            {{#each projects}}
            <article class="custom-card">
                {{#if image}}
                <img src="{{image}}" alt="{{title}}" class="img-fluid mb-3">
                {{/if}}
                <h3>{{title}}</h3>
                <p>{{description}}</p>
                <a href="/project/{{id}}" class="btn btn-main">View Project</a>
            </article>
            {{/each}}
        </div>
        {{else}}
        <p class="text-center">0 projects available</p>
        <p class="text-center">##### No projects available yet</p>
        <p class="text-center">Add a project from the Add Project page and it will appear here automatically.</p>
        {{/if}}
        {{#if user}}
        <div class="text-center mt-4">
            <a href="/projects/add" class="btn btn-main">Add Project</a>
        </div>
        {{/if}}
    </section>
</div>